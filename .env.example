# ============================================================
# Moezia Associados - variaveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite o .env.local (ja esta no .gitignore).
# ============================================================

# --- Supabase ---
# URL e chaves do projeto Supabase (Settings > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publica_anon_aqui
# Chave de servico (service_role) - NUNCA expor no client, so em rotas server-side
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui

# --- NextAuth ---
# Gere um valor aleatorio com: openssl rand -base64 32
NEXTAUTH_SECRET=gere_um_valor_aleatorio_aqui
NEXTAUTH_URL=http://localhost:3000

# --- Auto-commit local (opcional) ---
# Habilita o commit git automatico quando um andamento e atualizado pelo admin.
# So funciona quando o app roda localmente (nao em hospedagem serverless).
ENABLE_AUTO_GIT_COMMIT=true
